PORT=3000

# MongoDB Atlas (recommended). Leave unset in development to use in-memory MongoDB.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/khata?retryWrites=true&w=majority

SESSION_SECRET=change-me-to-a-long-random-string

NODE_ENV=development

# --- Seed credentials (required before first npm run reset-data or fresh deploy) ---
# PINs for the two shops — 4 digits each. Each account must change these at first login.
SEED_SHOP1_PIN=1234
SEED_SHOP2_PIN=5678

# Admin password — at least 8 characters. Must be changed at first login.
SEED_ADMIN_PASSWORD=changeme1
